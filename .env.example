# Grok Responses-compatible gateway. Provide root URL or /v1; endpoint is normalized automatically.
# Auth modes:
#   api_key: use GROK_SEARCH_API_KEY
#   oauth: run `nova-veil-search login`, then set GROK_SEARCH_AUTH_MODE=oauth
GROK_SEARCH_AUTH_MODE=api_key
# GROK_SEARCH_AUTH_FILE=C:\Users\you\.config\nova-veil-search\auth.json
GROK_SEARCH_API_KEY=your-grok-compatible-key
GROK_SEARCH_URL=https://api.x.ai
GROK_SEARCH_MODEL=grok-4-1-fast-reasoning

# web_search is enabled by default. x_search is disabled by default.
GROK_SEARCH_WEB_SEARCH=true
GROK_SEARCH_X_SEARCH=false

# Tavily provides extra sources, URL fetch, and site map. Enabled by default when a key is present.
# Multiple keys: comma-separate them (TAVILY_API_KEY=tvly-a,tvly-b) for round-robin
# rotation with automatic failover on key-scoped errors (401/403/429/432/433).
TAVILY_API_KEY=tvly-your-key
TAVILY_API_URL=https://api.tavily.com
# TAVILY_ENABLED=false

# Firecrawl provides fetch fallback and supplemental source fallback. Enabled by default when a key is present.
# FIRECRAWL_API_KEY=fc-your-key
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# FIRECRAWL_ENABLED=false

# TinyFish Search & Fetch: free (no credits, rate-limited) search + JS-rendering fetch.
# Optional link in the source chain. https://agent.tinyfish.ai/api-keys
# TINYFISH_API_KEY=your-tinyfish-key
# TINYFISH_SEARCH_API_URL=https://api.search.tinyfish.ai
# TINYFISH_FETCH_API_URL=https://api.fetch.tinyfish.ai
# TINYFISH_ENABLED=false

# Exa: semantic search with native domain/date filters (paid, per-request).
# Optional link in the source chain. https://dashboard.exa.ai/api-keys
# EXA_API_KEY=your-exa-key
# EXA_API_URL=https://api.exa.ai
# EXA_ENABLED=false

# ── Keyless / free engines (no API key, rate-limited) ───────────────────────
# DuckDuckGo (keyless web search, scrapes the html/lite endpoints) — on by default.
# DUCKDUCKGO_ENABLED=false
# DUCKDUCKGO_REGION=us-en        # optional `kl` region/ad unit (e.g. cn-zh, wt-wt)

# Bing (keyless web search) — on by default. A query/result relevance guard drops
# Bing's zero-result cached SERPs instead of feeding them to the model.
# BING_ENABLED=false
# BING_MARKET=en-US              # optional `mkt` market override (e.g. zh-CN)

# Anonymous (keyless) modes for paid providers. When the *_KEYLESS flag is set
# the provider instantiates even without a key, using its free anonymous tier:
#   Tavily      → `x-tavily-access-mode: keyless` header (rate-limited)
#   Firecrawl   → no Authorization header on its hosted /v2 endpoints
#   Exa         → the hosted public MCP `web_search_exa` tool (search-only)
# A present key always wins over the keyless flag.
# TAVILY_KEYLESS=false
# FIRECRAWL_KEYLESS=false
# EXA_KEYLESS=false

# Source chain order for supplemental sources + generic fetch. Default (omit):
# configured providers in canonical order
# tavily,exa,tinyfish,duckduckgo,bing,firecrawl.
# GROK_SEARCH_SOURCE_PROVIDERS=tavily,tinyfish,firecrawl

# ── OpenAI-compatible transport (alternative to GROK_SEARCH_*) ───
# When GROK_SEARCH_API_KEY above is unset and these three are set,
# nova-veil-search talks to /v1/chat/completions instead of /v1/responses.
# Useful for OpenAI-compatible gateways that do not implement /responses.
# OPENAI_COMPATIBLE_API_URL=https://your-gateway/v1
# OPENAI_COMPATIBLE_API_KEY=sk-...
# OPENAI_COMPATIBLE_MODEL=grok-4.3-fast

# Search source behavior.
GROK_SEARCH_EXTRA_SOURCES=3
GROK_SEARCH_FALLBACK_SOURCES=5
GROK_SEARCH_CACHE_SIZE=256
GROK_SEARCH_TIMEOUT_SECONDS=60

# Query-result cache for the supplemental source fan-out (keyless engines hit
# rate limits, so repeat queries within the window return cached results).
# GROK_SEARCH_RESULT_CACHE_SIZE=50          # max cached queries (LRU)
# GROK_SEARCH_RESULT_CACHE_TTL_SECONDS=300  # per-entry age limit; 0 disables the cache

# ── Remote Streamable HTTP transport (server build: `--features http`) ──────
# Only meaningful when running the server (`nova-veil-search --http` / docker).
# Keys are ALWAYS server-side (built-in): the *_API_KEY values above are what
# every request runs on; callers NEVER supply their own keys.
# GROK_MCP_API_TOKEN is REQUIRED — every request must send
# `Authorization: Bearer <token>` or a session token from /login.
# GROK_MCP_API_TOKEN=change-me-to-a-long-random-token
# GROK_MCP_BIND=0.0.0.0:8080

# ── Web UI login (POST /login -> session token) ─────────────────────────────
# Set NOVA_ADMIN_PASSWORD to enable the login endpoint that issues short-lived
# session tokens for a settings/config frontend. Unset -> /login disabled.
# NOVA_ADMIN_USER=admin
# NOVA_ADMIN_PASSWORD=change-me-to-a-long-random-password
# NOVA_SESSION_TTL_SECONDS=43200

# ── Settings/config frontend (GET / + /api/config) — opt-in, OFF by default ──
# Enabling serves the embedded settings SPA and lets each request read
# config.toml (env > file > defaults). OFF = pure backend (/mcp + /messages +
# /login only): no frontend routes, no per-request config.toml read.
# NOVA_CONFIG_UI=true
